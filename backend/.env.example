# Database (Neon Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/collegebook?sslmode=require"

# Auth
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Redis (Phase 8 — optional; rate limiting, presence, and broadcast
# fan-out all degrade gracefully to single-instance/synchronous mode if
# this is unset. Set it locally to test the real Redis-backed behavior.)
REDIS_URL="redis://localhost:6379"

# Supabase Storage — used for profile/cover/post/yearbook images. Files
# are resized and compressed with sharp on this server BEFORE upload
# (see services/upload.service.js), so raw phone photos never land in
# storage at full size. Create a project at https://supabase.com, create
# a PUBLIC storage bucket (Storage -> New bucket -> toggle "Public"), and
# use the SERVICE ROLE key here (Settings -> API) — not the anon key —
# since this client runs server-side only and needs to write regardless
# of any bucket policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=collegebook-uploads

# Redis (Phase 8 — optional). Everything that uses it degrades gracefully
# when unset: rate limiting falls back to in-memory (single-instance-only),
# Socket.IO presence/broadcast stays local to one process, and broadcast
# fan-out runs synchronously instead of via the queue/worker.
# Local dev: redis://localhost:6379
# Managed (e.g. Render Key Value / Upstash): use the connection string they give you.
REDIS_URL=

# Google Sign-In (login only, not sign-up — see auth.service.js's
# loginWithGoogle for why). Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials, type "Web
# application", and add your frontend's origin (e.g.
# http://localhost:5173) under "Authorized JavaScript origins". This same
# value also goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Resend (transactional email) — sends a student an email the moment an
# admin changes their verification status (verified/suspended/graduated/
# alumni). Optional — if unset, status changes still work exactly the
# same, just with no email sent (see services/email.service.js).
# Get a key at https://resend.com/api-keys. RESEND_FROM_EMAIL must be an
# address on a domain you've verified in Resend — for quick local
# testing before verifying your own domain, Resend provides
# onboarding@resend.dev, which works out of the box with no setup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev


# News & Feeds — NewsData.io
# Keep the provider key on the backend only; never use a VITE_* variable for it.
NEWSDATA_API_KEY=
NEWSDATA_API_URL="https://newsdata.io/api/1/latest"
NEWS_FEEDS_CACHE_MINUTES=60
NEWS_FEEDS_COUNTRIES="ng,us,gb"
NEWS_FEEDS_LANGUAGE="en"
NEWS_FEEDS_LIMIT=10
