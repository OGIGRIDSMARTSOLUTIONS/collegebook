// CollegeBook — Prisma schema
// Source of truth for /docs/DATABASE_SECURITY_ARCHITECTURE.md
// Institution-tenant isolation: every tenant-owned model carries institutionId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  INSTITUTION_MODERATOR
  YEARBOOK_ADMIN
  STUDENT
  ALUMNI
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
}

enum CrossInstitutionPolicy {
  OFF
  CONNECTION_ONLY
  MESSAGE_AFTER_CONNECTION
  MESSAGE_WITHOUT_CONNECTION
  FULL_INTERACTION
}

enum AcademicSetKind {
  ADMISSION_COHORT
  GRADUATION_COHORT
  CLASS
  DEPARTMENTAL
  FACULTY
  SCHOOL
  PROFESSIONAL
}

enum SetStatus {
  ACTIVE
  GRADUATED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  GRADUATED
  ALUMNI
}

enum MessagePrivacy {
  NOBODY_EXCEPT_CONNECTIONS
  SET_ONLY
  INSTITUTION_ONLY
  APPROVED_INSTITUTIONS
  EVERYONE
}

enum ProfilePrivacy {
  CONNECTIONS_ONLY
  SET_ONLY
  INSTITUTION_ONLY
  EVERYONE
}

enum PostVisibility {
  PUBLIC
  INSTITUTION
  SET
  CONNECTIONS
}

enum ReactionType {
  LIKE
  LOVE
  CELEBRATE
  SUPPORT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum ConversationType {
  PRIVATE
  SET
  INSTITUTION
  CROSS_INSTITUTION
  GROUP
}

enum NotificationType {
  MESSAGE
  CONNECTION
  COMMENT
  LIKE
  MENTION
  SHARE
  INSTITUTION_BROADCAST
  YEARBOOK
  SYSTEM
}

enum BroadcastScope {
  ALL
  SET
  DEPARTMENT
  FACULTY
  CUSTOM
}

enum YearBookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum YearBookSectionKind {
  FACULTY
  DEPARTMENT
  EVENTS
  ACHIEVEMENTS
  MEMORIES
}

enum ReportTargetType {
  POST
  COMMENT
  PROFILE
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum GroupKind {
  PUBLIC
  PRIVATE
}
// Note (scope, same class of gap as Phase 4's "Set Group Chat"):
// INSTITUTION/SET/DEPARTMENT auto-groups are deliberately not modeled yet.
// An auto-group needs membership kept in sync as students join/leave the
// underlying set/department, which is separate infrastructure from the
// user-created PUBLIC/PRIVATE groups implemented in Phase 7.

enum GroupMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

// ─────────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(cuid())
  email            String?       @unique
  username         String?       @unique
  phone            String?       @unique
  passwordHash     String
  role             Role          @default(STUDENT)
  accountStatus    AccountStatus @default(PENDING)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  refreshTokenHash String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student   Student?
  auditLogs AuditLog[]
  institutionEvents InstitutionEvent[] @relation("InstitutionEventCreator")
  institutionStaff InstitutionStaff?

  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// TENANT LAYER
// ─────────────────────────────────────────────────────────────

model Institution {
  id                      String                  @id @default(cuid())
  code                    String                  @unique // INST_000001 style public code
  institutionCode         String                  @unique // e.g. UNILAG
  name                    String
  shortName               String?
  logoUrl                 String?
  coverImageUrl           String?
  description             String?
  colours                 Json?
  website                 String?
  location                String?
  status                  InstitutionStatus       @default(ACTIVE)
  crossInstitutionPolicy  CrossInstitutionPolicy  @default(CONNECTION_ONLY)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  faculties    Faculty[]
  departments  Department[]
  academicSets AcademicSet[]
  students     Student[]
  broadcasts   Broadcast[]
  yearBooks    YearBook[]
  auditLogs    AuditLog[]
  events       InstitutionEvent[]
  staff        InstitutionStaff[]

  @@map("institutions")
}

model InstitutionStaff {
  id            String      @id @default(cuid())
  userId        String      @unique
  institutionId String
  firstName     String
  lastName      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("institution_staff")
}

model Faculty {
  id            String   @id @default(cuid())
  code          String
  name          String
  institutionId String
  createdAt     DateTime @default(now())

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments Department[]
  students    Student[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("faculties")
}

model Department {
  id            String   @id @default(cuid())
  code          String
  name          String
  institutionId String
  facultyId     String
  createdAt     DateTime @default(now())

  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  faculty     Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students    Student[]
  academicSets AcademicSet[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([facultyId])
  @@map("departments")
}

model AcademicSet {
  id             String          @id @default(cuid())
  code           String          @unique // SET_000125 style
  name           String
  institutionId  String
  departmentId   String?
  kind           AcademicSetKind @default(ADMISSION_COHORT)
  startYear      Int
  endYear        Int?
  graduationYear Int?
  status         SetStatus       @default(ACTIVE)
  createdAt      DateTime        @default(now())

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  students    Student[]
  yearBooks   YearBook[]

  @@index([institutionId])
  @@index([departmentId])
  @@map("academic_sets")
}

// ─────────────────────────────────────────────────────────────
// STUDENT IDENTITY
// ─────────────────────────────────────────────────────────────

model Student {
  id                 String              @id @default(cuid())
  code               String              @unique // STU_001245 style
  userId             String?             @unique
  institutionId      String
  setId              String
  departmentId       String?
  facultyId          String?
  studentNumber      String?
  firstName          String
  lastName           String
  otherNames         String?
  phoneNumber        String?
  profilePhotoUrl    String?
  coverPhotoUrl      String?
  bio                String?
  gender             String?
  location           String?
  dateOfBirth        DateTime?
  verificationStatus VerificationStatus  @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSet  AcademicSet   @relation(fields: [setId], references: [id], onDelete: Restrict)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  privacy      StudentPrivacy?

  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  connectionsSent     Connection[]              @relation("ConnectionRequester")
  connectionsReceived Connection[]              @relation("ConnectionAddressee")
  conversations       ConversationParticipant[]
  messages            Message[]
  mentionsReceived    MessageMention[] @relation("MentionedStudent")
  notifications       Notification[]
  broadcastReceipts   BroadcastRecipient[]
  yearBookEntries     YearBookStudent[]
  reportsFiled        Report[]                  @relation("ReporterStudent")
  groupsCreated       Group[]                   @relation("GroupCreator")
  groupMemberships    GroupMembership[]
  savedPosts          SavedPost[]

  @@unique([institutionId, studentNumber])
  @@index([institutionId])
  @@index([setId])
  @@index([departmentId])
  @@map("students")
}

model StudentPrivacy {
  id                String         @id @default(cuid())
  studentId         String         @unique
  whoCanMessage     MessagePrivacy @default(INSTITUTION_ONLY)
  whoCanViewProfile ProfilePrivacy @default(EVERYONE)
  whoCanViewPosts   ProfilePrivacy @default(INSTITUTION_ONLY)
  showBirthday      Boolean        @default(true)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_privacy")
}

// ─────────────────────────────────────────────────────────────
// SOCIAL LAYER
// ─────────────────────────────────────────────────────────────

model Post {
  id            String         @id @default(cuid())
  authorId      String
  institutionId String // denormalized for fast feed scoping — never used alone for access control
  groupId       String? // when set, this post belongs to a Group and visibility is membership-based, not PostVisibility
  body          String?
  images        Json? // string[]
  linkUrl       String?
  visibility    PostVisibility @default(INSTITUTION)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  author    Student     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group     Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]
  reports   Report[]
  savedBy   SavedPost[]

  @@index([authorId])
  @@index([institutionId, createdAt])
  @@index([groupId])
  @@map("posts")
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  authorId        String
  parentCommentId String?
  body            String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Student    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  reactions Reaction[]
  reports   Report[]

  @@index([postId])
  @@index([parentCommentId])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(cuid())
  studentId String
  postId    String?
  commentId String?
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([postId, studentId])
  @@unique([commentId, studentId])
  @@map("reactions")
}

model Connection {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       ConnectionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  requester Student @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Student @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("connections")
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  targetType     ReportTargetType
  postId         String?
  commentId      String?
  reason         String
  status         ReportStatus     @default(PENDING)
  createdAt      DateTime         @default(now())

  reporter Student  @relation("ReporterStudent", fields: [reporterId], references: [id], onDelete: Cascade)
  post     Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────────────────────

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(PRIVATE)
  createdAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  studentId      String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, studentId])
  @@index([studentId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String?
  attachmentUrl  String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Student      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  mentions     MessageMention[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageMention {
  id          String   @id @default(cuid())
  messageId   String
  studentId   String
  startOffset Int
  endOffset   Int
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  student Student @relation("MentionedStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([messageId, studentId, startOffset])
  @@index([studentId, createdAt])
  @@map("message_mentions")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  payload     Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient Student @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// BROADCASTS
// ─────────────────────────────────────────────────────────────

model Broadcast {
  id            String         @id @default(cuid())
  institutionId String
  authorUserId  String
  title         String
  body          String
  scope         BroadcastScope @default(ALL)
  scopeIds      Json? // string[] of set/department/faculty ids when scope != ALL
  createdAt     DateTime       @default(now())

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  recipients  BroadcastRecipient[]

  @@index([institutionId])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  studentId   String
  readAt      DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, studentId])
  @@map("broadcast_recipients")
}


// ─────────────────────────────────────────────────────────────
// INSTITUTION EVENTS / MEMORABLE DAYS
// ─────────────────────────────────────────────────────────────

model InstitutionEvent {
  id            String   @id @default(cuid())
  institutionId String
  createdByUserId String
  title         String
  description   String?
  eventDate     DateTime
  endDate       DateTime?
  location      String?
  category      String   @default("GENERAL")
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("InstitutionEventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([institutionId, eventDate])
  @@index([institutionId, isPublished])
  @@map("institution_events")
}

// ─────────────────────────────────────────────────────────────
// YEARBOOK (strictly institution-isolated)
// ─────────────────────────────────────────────────────────────

model YearBook {
  id             String         @id @default(cuid())
  institutionId  String
  setId          String?
  year           String
  status         YearBookStatus @default(DRAFT)
  coverImageUrl  String?
  welcomeMessage String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSet AcademicSet?       @relation(fields: [setId], references: [id], onDelete: SetNull)
  sections    YearBookSection[]
  students    YearBookStudent[]
  photos      YearBookPhoto[]

  @@unique([institutionId, year, setId])
  @@index([institutionId])
  @@map("year_books")
}

model YearBookSection {
  id         String              @id @default(cuid())
  yearBookId String
  kind       YearBookSectionKind
  title      String
  order      Int                 @default(0)

  yearBook YearBook          @relation(fields: [yearBookId], references: [id], onDelete: Cascade)
  photos   YearBookPhoto[]
  contents YearBookContent[]

  @@index([yearBookId])
  @@map("year_book_sections")
}

model YearBookStudent {
  id            String  @id @default(cuid())
  yearBookId    String
  institutionId String // denormalized — always re-checked against Student.institutionId
  studentId     String
  photoUrl      String?
  quote         String?

  yearBook YearBook @relation(fields: [yearBookId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([yearBookId, studentId])
  @@index([institutionId])
  @@map("year_book_students")
}

model YearBookPhoto {
  id              String   @id @default(cuid())
  yearBookId      String
  sectionId       String?
  url             String
  caption         String?
  uploadedByUserId String
  createdAt       DateTime @default(now())

  yearBook YearBook         @relation(fields: [yearBookId], references: [id], onDelete: Cascade)
  section  YearBookSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([yearBookId])
  @@map("year_book_photos")
}

model YearBookContent {
  id        String @id @default(cuid())
  yearBookId String
  sectionId String
  body      String

  section YearBookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("year_book_contents")
}

// ─────────────────────────────────────────────────────────────
// GROUPS & SAVED POSTS (Phase 7)
// ─────────────────────────────────────────────────────────────

model Group {
  id            String    @id @default(cuid())
  name          String
  description   String?
  kind          GroupKind @default(PUBLIC)
  institutionId String? // optional anchor (e.g. "grew out of this institution") — null for a fully open cross-institution group. Not an access-control field by itself; membership is.
  creatorId     String
  createdAt     DateTime  @default(now())

  creator     Student           @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  posts       Post[]

  @@index([institutionId])
  @@map("groups")
}

model GroupMembership {
  id        String          @id @default(cuid())
  groupId   String
  studentId String
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
  @@map("group_memberships")
}

model SavedPost {
  id        String   @id @default(cuid())
  studentId String
  postId    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([studentId, postId])
  @@map("saved_posts")
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?
  actorUserId   String
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  ip            String?
  createdAt     DateTime @default(now())

  actor       User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([actorUserId])
  @@map("audit_logs")
}
