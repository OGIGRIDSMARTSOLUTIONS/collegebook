# Base URL of the backend API, INCLUDING /api — src/services/api.js uses
# this as axios's baseURL directly, so every service call (e.g.
# api.get('/auth/me')) is relative to this. See backend/.env.example for
# the server side.
VITE_API_URL=http://localhost:4000/api

# Google Sign-In (login only — see backend/src/services/auth.service.js's
# loginWithGoogle). Must be the SAME Client ID as backend/.env's
# GOOGLE_CLIENT_ID. If left empty, the Google button simply doesn't
# render — this is an optional feature, not a hard requirement.
VITE_GOOGLE_CLIENT_ID=
