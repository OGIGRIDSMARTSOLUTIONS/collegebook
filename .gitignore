
# ============================================
# COLLEGEBOOK - GIT IGNORE RULES
# ============================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Authentication cookies and sessions
backend/*_cookies.txt
*_cookies.txt

# Vercel local configuration
.vercel/
**/.vercel/

# Build outputs
dist/
**/dist/
build/
**/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp

# Operating system files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
